# ============================================================================
# OpenSandbox Server 配置模板 —— Governed 专用
#
# 用法：
#   1. 复制本文件为同目录下 sandbox.toml（该文件不进版本库）
#        Copy-Item sandbox.toml.example sandbox.toml
#   2. 通过 start.ps1 启动；服务端 api_key 由环境变量注入（见 start.ps1），
#      本文件里 api_key 留空即可。
#
# 说明：服务端是 Governed 的「沙箱层」基础设施，与 Redis/Kafka/MinIO 同级。
# 客户端 SDK（项目 .venv 里的 opensandbox）通过 HTTP 连本服务，不直连 Docker。
# ============================================================================

[server]
host = "127.0.0.1"
port = 8080
max_sandbox_timeout_seconds = 86400
# 留空：实际凭据由 start.ps1 通过环境变量 OPENSANDBOX_SERVER_API_KEY 注入并覆盖此处。
# 生产请使用长随机串并定期轮换；客户端 SANDBOX_API_KEY 必须与之完全一致。
api_key = ""

[log]
level = "INFO"

[runtime]
type = "docker"
execd_image = "opensandbox/execd:v1.0.22"

# ---------------------------------------------------------------------------
# 文件访问平面（PPT 所述「主机 + 沙箱双层文件访问平面」的落地点）
#
# 本项目的文件两层：
#   主机平面 = 项目 VFS（data/vfs/workspace、data/vfs/reports）
#   沙箱平面 = 容器内私有文件系统（/tmp/...）
#   之间的唯一通道 = SDK 的 Filesystem API（write_file / read_file / search …）
#
# 因此这里**禁止一切宿主路径 bind mount**：沙箱进程看不到任何宿主路径，
# 文件内容经 API 显式搬运，天然带审计点与大小上限，比挂载更严格。
# 仅在确有「大文件免搬运」需求时才加入白名单，例如：
#   allowed_host_paths = ["D:/Next-Harness/data/vfs"]
# ---------------------------------------------------------------------------
[storage]
allowed_host_paths = []
volume_default_size = "1Gi"

[store]
# 默认 sqlite，无需 Postgres/Redis。
# 相对路径：start.ps1 会把工作目录切到本配置所在目录，故解析到本目录 state/ 下，
# 不写死任何机器绝对路径（state/ 已被 .gitignore 忽略）。
type = "sqlite"
path = "state/opensandbox.db"

[docker]
network_mode = "bridge"
# 每个沙箱占 2~3 个宿主端口（带 egress sidecar 时 3 个）
port_range_min = 40000
port_range_max = 60000
drop_capabilities = [
    "AUDIT_WRITE", "MKNOD", "NET_ADMIN", "NET_RAW",
    "SYS_ADMIN", "SYS_MODULE", "SYS_PTRACE", "SYS_TIME", "SYS_TTY_CONFIG",
]
no_new_privileges = true
apparmor_profile = ""
# 限制进程数，降低 fork 炸弹对宿主的冲击
pids_limit = 4096
seccomp_profile = ""

[ingress]
mode = "direct"

[egress]
image = "opensandbox/egress:v1.1.7"
# dns 模式 = FQDN 级出网管控（配合 Credential Vault，让真实密钥不进入沙箱负载）
mode = "dns"
# 就绪等待上限。默认 30s 在「高频连续建沙箱」下不够：实测 51 次连续调用时
# egress sidecar 会因 Docker 负载起不来，报 SANDBOX_START_FAILED。
# 放宽到 120s，避免把并发压力误判成启动失败。
readiness_timeout_seconds = 120.0

[renew_intent]
enabled = false
min_interval_seconds = 60
