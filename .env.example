# ============================================================
# LLM 配置（OpenAI 兼容接口）
# ============================================================
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 可选：其他 OpenAI 兼容模型
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Embedding 模型（用于长期记忆向量检索）
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_API_KEY=your_embedding_key_here
EMBEDDING_BASE_URL=https://api.openai.com/v1

# ============================================================
# Redis —— 短期记忆、任务状态、缓存、分布式锁、限流
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=etl_harness:

# ============================================================
# Milvus —— 长期向量记忆
# ============================================================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_PREFIX=etl_harness_
MILVUS_INDEX_TYPE=HNSW
MILVUS_METRIC_TYPE=COSINE

# ============================================================
# Kafka —— 审计日志、链路追踪、事件总线
# ============================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_AUDIT_TOPIC=etl_harness_audit
KAFKA_TRACE_TOPIC=etl_harness_trace
KAFKA_EVENT_TOPIC=etl_harness_events
KAFKA_CONSUMER_GROUP=etl_harness_consumer
KAFKA_ENABLE_AUDIT_PRODUCE=true
KAFKA_ENABLE_TRACE_PRODUCE=true

# ============================================================
# MinIO —— VFS 虚拟文件系统后端
# ============================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=etl-harness
MINIO_SECURE=false

# VFS 本地回退目录（MinIO 不可用时使用）
VFS_LOCAL_ROOT=data/vfs

# ============================================================
# FastAPI 服务层
# ============================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=1
SERVER_RELOAD=false
SERVER_CORS_ORIGINS=*
SERVER_API_PREFIX=/api/v1

# ============================================================
# 安全沙箱（Docker 容器隔离）
# ============================================================
SANDBOX_ENABLED=true
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_NETWORK_ENABLED=false
SANDBOX_WORKDIR=/sandbox/workspace

# ============================================================
# 链路追踪
# ============================================================
TRACE_ENABLED=true
TRACE_SAMPLE_RATE=1.0
TRACE_SERVICE_NAME=etl-harness
TRACE_ENVIRONMENT=development

# ============================================================
# 运行配置
# ============================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
CHECKPOINT_DIR=data/checkpoints
AUDIT_DIR=data/audit
MEMORY_DIR=data/memory
MAX_WORKERS=10
DEFAULT_MAX_STEPS=20
DEFAULT_TIMEOUT_SECONDS=300
